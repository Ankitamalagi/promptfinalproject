# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application settings
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# Security settings
# Server-side policy: ALLOW, FLAG, BLOCK, or SANITIZE
DEFAULT_POLICY=ALLOW

# Risk score thresholds (configurable)
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60
RISK_THRESHOLD_HIGH=80

# Input size limits (characters)
MAX_USER_MESSAGE_LENGTH=10000
MAX_RETRIEVED_CONTENT_LENGTH=50000

# Provider settings (optional - for real LLM integration)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=30

# Audit settings
AUDIT_STORE_RAW_PROMPTS=false